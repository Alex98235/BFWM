                <object label="Based on commit 137651a (2026-11-27) · src/window/**, src/transaction/**" basedOn="137651a" date="2026-11-27" covers="src/window/events/events.cpp;src/window/events/events.h;src/window/filter.cpp;src/window/cloaking.cpp;src/window/rules/rules.cpp;src/window/window.cpp;src/window/border/overlay.cpp;src/window/focus.cpp;src/window/cleanup.cpp;src/window/fullscreen" id="prov">
