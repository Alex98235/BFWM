                <mxCell id="p5" parent="cL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=11;" value="&lt;b&gt;CommitMonitorVisibility()&lt;/b&gt; monitor.cpp:605&lt;br&gt;&lt;b&gt;Move-workspace-to-monitor&lt;/b&gt; handlers.cpp:1189" vertex="1">
