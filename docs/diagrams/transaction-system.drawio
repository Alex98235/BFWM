                <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A626E;" value="Handlers mutate BFWM&#39;s model and queue operations; nothing touches Win32 until one commit flushes every queued op in a fixed 10-pass order." vertex="1">
