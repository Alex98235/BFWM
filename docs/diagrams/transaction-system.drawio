                    <mxGeometry height="66" width="528" x="16" y="656" as="geometry"/>
                </mxCell>
                <mxCell id="r12" parent="cR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontSize=11;" value="&lt;b&gt;:585 · FlushOverlayRings()&lt;/b&gt; → ReconcileOverlay + FlushOverlay&lt;br&gt;ONE DComp commit, then ForceDwmComposite() = DwmFlush()" vertex="1">
                    <mxGeometry height="52" width="528" x="16" y="732" as="geometry"/>
                </mxCell>
                <mxCell id="r13" parent="cR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#B8C0CC;fontSize=11;" value="&lt;b&gt;:590 · ClearOps(); in_transaction = FALSE&lt;/b&gt;" vertex="1">
                    <mxGeometry height="40" width="528" x="16" y="794" as="geometry"/>
                </mxCell>
                <mxCell id="rNote" parent="cR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#E9D58A;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;" value="&lt;b&gt;Why this order:&lt;/b&gt; DWM must see the final cloak state before any SetWindowPos (P1); style changes and z-order must land before geometry (P2, P3) or the engine tiles to stale frames; focus runs last and re-queues its own border/redraw so the active border can never be overwritten by an inactive one queued during the relayout." vertex="1">
                    <mxGeometry height="120" width="528" x="16" y="846" as="geometry"/>
                </mxCell>
                <mxCell id="cW" parent="1" style="swimlane;startSize=28;fillColor=#F7F8FA;strokeColor=#C9D1DC;html=1;fontStyle=1;fontColor=#1B1F24;verticalAlign=top;" value="Op catalogue — producer → Win32 effect" vertex="1">
                    <mxGeometry height="250" width="820" x="40" y="700" as="geometry"/>
                </mxCell>
                <mxCell id="wA" parent="cW" style="text;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=4;" value="&lt;b&gt;OP_MOVE_WINDOW&lt;/b&gt; → PlacementIssueMove (async)&lt;br&gt;&lt;b&gt;OP_RELAYOUT_WORKSPACE&lt;/b&gt; → Workspace::ApplyLayout&lt;br&gt;&lt;b&gt;OP_BORDER_COLOR&lt;/b&gt; → Window::SetOverlayColor (if visible)&lt;br&gt;&lt;b&gt;OP_CLOAK_WINDOW&lt;/b&gt; → SetWindowCloakState (DWM)&lt;br&gt;&lt;b&gt;OP_CLOSE_WINDOW&lt;/b&gt; → WM_CLOSE, 2 s timeout &lt;i&gt;(no producer)&lt;/i&gt;&lt;br&gt;&lt;b&gt;OP_FOCUS_WINDOW&lt;/b&gt; → FocusWindowImmediate&lt;br&gt;&lt;b&gt;OP_ZORDER&lt;/b&gt; → SetWindowPos(ASYNCWINDOWPOS)&lt;br&gt;&lt;b&gt;OP_SHOW_WINDOW&lt;/b&gt; → ShowWindow(SW_SHOW)" vertex="1">
                    <mxGeometry height="200" width="386" x="16" y="36" as="geometry"/>
                </mxCell>
                <mxCell id="wB" parent="cW" style="text;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=4;" value="&lt;b&gt;OP_HIDE_WINDOW&lt;/b&gt; → &lt;i&gt;never emitted&lt;/i&gt; (QueueHideWindow emits SHOW{visible=0})&lt;br&gt;&lt;b&gt;OP_SET_WINDOW_STYLE&lt;/b&gt; → SetWindowLongW + FRAMECHANGED&lt;br&gt;&lt;b&gt;OP_REDRAW_BORDER&lt;/b&gt; → RedrawWindow(RDW_FRAME)&lt;br&gt;&lt;b&gt;OP_REDRAW_CONTENT&lt;/b&gt; → RedrawWindow(RDW_INVALIDATE)&lt;br&gt;&lt;b&gt;OP_MINIMIZE_WINDOW&lt;/b&gt; → ShowWindow(SW_MINIMIZE) &lt;i&gt;(no producer)&lt;/i&gt;&lt;br&gt;&lt;b&gt;OP_UPDATE_FOCUS_TRACKING&lt;/b&gt; → no-op (handled inline)&lt;br&gt;&lt;b&gt;OP_BAR_VISIBILITY&lt;/b&gt; → Bar::Show / Bar::Hide" vertex="1">
                    <mxGeometry height="200" width="386" x="418" y="36" as="geometry"/>
                </mxCell>
                <mxCell id="warn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#EBA3A3;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;strokeWidth=2;" value="&lt;b&gt;Known defect — ops queued during P4 can be lost&lt;/b&gt;&lt;br&gt;ApplyLayout runs in P4 and may queue OP_CLOAK_WINDOW (CloakInactiveWorkspaces), OP_SET_WINDOW_STYLE and OP_ZORDER. P1–P3 have already run and no later pass consumes those kinds, so ClearOps() discards them at :591. Only the moves and border colours it queues survive (P5/P6). Today it is masked because CloakInactiveWorkspaces skips windows already cloaked." vertex="1">
                    <mxGeometry height="140" width="820" x="40" y="970" as="geometry"/>
                </mxCell>
