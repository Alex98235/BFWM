                <mxCell id="e6" edge="1" parent="c2" source="r5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontSize=10;" target="r6">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e7" edge="1" parent="c2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontSize=10;">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="230" y="259.9999999999999" as="sourcePoint"/>
                        <mxPoint x="230" y="318" as="targetPoint"/>
