                    <mxGeometry height="32" width="408" x="16" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="r3" parent="c2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6E0;strokeColor=#E8C36A;fontSize=11;roundedPerimeter=1;" value="&lt;b&gt;workspace_rect&lt;/b&gt;" vertex="1">
                    <mxGeometry height="32" width="408" x="16" y="124" as="geometry"/>
                </mxCell>
                <mxCell id="r4" parent="c2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#B8C0CC;fontSize=11;roundedPerimeter=1;" value="inset gap_edge on all four sides (0 when gaps_enabled = 0)&lt;br&gt;gaps and border_width were scaled once from the monitor DPI" vertex="1">
                    <mxGeometry height="48" width="408" x="16" y="168" as="geometry"/>
                </mxCell>
                <mxCell id="r5" parent="c2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6E0;strokeColor=#E8C36A;fontSize=11;roundedPerimeter=1;" value="&lt;b&gt;engine rect&lt;/b&gt;" vertex="1">
                    <mxGeometry height="32" width="408" x="16" y="228" as="geometry"/>
                </mxCell>
                <mxCell id="r6" parent="c2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=11;roundedPerimeter=1;" value="&lt;b&gt;master / monocle:&lt;/b&gt; tiled_rect = engine rect − border_width" vertex="1">
                    <mxGeometry height="36" width="408" x="16" y="272" as="geometry"/>
                </mxCell>
                <mxCell id="r7" parent="c2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=11;roundedPerimeter=1;" value="&lt;b&gt;dwindle:&lt;/b&gt; leaf rect − border_width, plus half of gap_between on every interior side (detected against the engine rect)" vertex="1">
                    <mxGeometry height="52" width="408" x="16" y="318" as="geometry"/>
                </mxCell>
                <mxCell id="r8" parent="c2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#B8C0CC;fontSize=11;roundedPerimeter=1;" value="&lt;b&gt;usable_rect&lt;/b&gt; = workspace_rect − (gap_edge + border_width)&lt;br&gt;&lt;i&gt;used only to clamp adopted stuck-window rects,&lt;/i&gt; never for normal placement" vertex="1">
                    <mxGeometry height="56" width="408" x="16" y="382" as="geometry"/>
                </mxCell>
                <mxCell id="e2" edge="1" parent="c2" source="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontSize=10;" target="r2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
