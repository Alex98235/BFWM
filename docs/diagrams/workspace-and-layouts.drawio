                <mxCell id="legend" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A94A6;rounded=1;roundedPerimeter=1;" value="Legend: yellow = geometry / cached state · blue = layout and UI logic · grey = derived or helper data · dashed = recovery or hotplug path" vertex="1">
