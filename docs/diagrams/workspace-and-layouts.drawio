                    <mxGeometry height="470" width="440" x="630" y="100" as="geometry"/>
                </mxCell>
                <mxCell id="r1" parent="c2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6E0;strokeColor=#E8C36A;fontSize=11;roundedPerimeter=1;" value="&lt;b&gt;monitor.work_area&lt;/b&gt; (physical px)" vertex="1">
