                </mxCell>
                <mxCell id="e10" edge="1" parent="c2" style="rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;fontSize=10;elbow=vertical;labelAutoRotate=0;shadow=0;defaultLabelBackgroundColor=page;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="c5" value="one Bar per monitor">
                    <mxGeometry relative="1" x="0.015" as="geometry">
                        <Array as="points">
