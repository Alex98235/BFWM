                    <mxGeometry height="30" width="528" x="16" y="412" as="geometry"/>
                </mxCell>
                <mxCell id="e1" edge="1" parent="c1" source="o3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;fontSize=10;" target="o5" value="owns">
                    <mxGeometry relative="1" as="geometry"/>
