    <diagram id="bfwm-workspace-and-layouts" name="Workspace and Layouts">
        <mxGraphModel dx="996" dy="647" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0" adaptiveColors="auto">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1B1F24;rounded=1;roundedPerimeter=1;" value="BFWM — Workspace and Layouts" vertex="1">
                    <mxGeometry height="34" width="900" x="40" y="16" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A626E;rounded=1;roundedPerimeter=1;" value="Monitors own workspaces, workspaces own layout engines, the registry owns windows. Layouts are DPI-pure — everything is scaled once when the workspace rect is built." vertex="1">
                    <mxGeometry height="26" width="1400" x="40" y="50" as="geometry"/>
                </mxCell>
                <mxCell id="c1" parent="1" style="swimlane;startSize=28;fillColor=#F7F8FA;strokeColor=#C9D1DC;html=1;fontStyle=1;fontColor=#1B1F24;verticalAlign=top;rounded=1;roundedPerimeter=1;" value="1 · Ownership" vertex="1">
                    <mxGeometry height="470" width="560" x="40" y="100" as="geometry"/>
                </mxCell>
                <mxCell id="o1" parent="c1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=11;roundedPerimeter=1;" value="&lt;b&gt;MainContext&lt;/b&gt; (main thread only)" vertex="1">
                    <mxGeometry height="36" width="528" x="16" y="36" as="geometry"/>
                </mxCell>
                <mxCell id="o2" parent="c1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=11;roundedPerimeter=1;" value="&lt;b&gt;MonitorRegistry&lt;/b&gt; — owns raw Monitor*&lt;br&gt;identity = PnP device instance UID (MONITOR\DEL4049\5&amp;amp;...)" vertex="1">
                    <mxGeometry height="52" width="528" x="16" y="84" as="geometry"/>
                </mxCell>
                <mxCell id="o3" parent="c1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=11;roundedPerimeter=1;" value="&lt;b&gt;Monitor&lt;/b&gt; owns: workspaces_ (raw Workspace*), active_workspace_ (non-owning),&lt;br&gt;unique_ptr&amp;lt;Bar&amp;gt; · bar_height_ (physical px) · fullscreen_count_" vertex="1">
                    <mxGeometry height="56" width="528" x="16" y="148" as="geometry"/>
                </mxCell>
                <mxCell id="o4" parent="c1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=11;roundedPerimeter=1;" value="&lt;b&gt;WindowRegistry&lt;/b&gt; — owns every unique_ptr&amp;lt;Window&amp;gt; globally.&lt;br&gt;Workspaces hold non-owning Window* only." vertex="1">
                    <mxGeometry height="52" width="528" x="16" y="216" as="geometry"/>
                </mxCell>
                <mxCell id="o5" parent="c1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=11;roundedPerimeter=1;" value="&lt;b&gt;Workspace&lt;/b&gt; owns unique_ptr&amp;lt;LayoutEngine&amp;gt; and a non-owning window list;&lt;br&gt;keeps workspace_rect (bar-reserved) and usable_rect (edge + border inset)" vertex="1">
                    <mxGeometry height="52" width="528" x="16" y="280" as="geometry"/>
                </mxCell>
                <mxCell id="o6" parent="c1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#E9D58A;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;roundedPerimeter=1;" value="IDs are globally unique even though workspaces live in a monitor array — FindWorkspaceById scans every monitor. A workspace is movable (MoveToMonitor) and records origin_monitor_uid_ so it can return on reconnect." vertex="1">
                    <mxGeometry height="62" width="528" x="16" y="344" as="geometry"/>
                </mxCell>
