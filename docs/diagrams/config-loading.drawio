                <mxCell id="b6" parent="cB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=11;" value="&lt;b&gt;parse_workspace_config()&lt;/b&gt; :356&lt;br&gt;id · label · assigned monitor · layout (32 max)" vertex="1">
