                </mxCell>
                <mxCell id="a7" parent="cA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#EBA3A3;fontSize=11;fontStyle=1;strokeWidth=2;" value="&lt;b&gt;ConfigLoadDefaults(shared)&lt;/b&gt; defaults.cpp:133" vertex="1">
                    <mxGeometry height="32" width="388" x="16" y="388" as="geometry"/>
                </mxCell>
                <mxCell id="a7b" parent="cA" style="text;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;fontColor=#B85450;" value="Writes every field and clears + repopulates keybinds with C defaults.&amp;nbsp;&lt;div&gt;&lt;b style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(98, 104, 128, 0.5) rgb(48, 52, 70);&quot;&gt;Runs BEFORE the user file&lt;/b&gt;&lt;span style=&quot;color: rgb(184, 84, 80);&quot;&gt; — this ordering is the source of the partial-failure state&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(184, 84, 80);&quot;&gt;&lt;span style=&quot;color: rgb(184, 84, 80);&quot;&gt;below.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="60" width="388" x="16" y="424" as="geometry"/>
                </mxCell>
                <mxCell id="a8" parent="cA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontSize=11;strokeWidth=2;" value="&lt;b&gt;luaL_dofile(path)&lt;/b&gt; parser.cpp:1971" vertex="1">
                    <mxGeometry height="32" width="388" x="16" y="494" as="geometry"/>
                </mxCell>
                <mxCell id="a9" parent="cA" style="text;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;fontColor=#5A626E;" value="on error: Snackbar::Error + return false&lt;br&gt;(post-load apply is then skipped)" vertex="1">
                    <mxGeometry height="44" width="388" x="16" y="530" as="geometry"/>
                </mxCell>
                <mxCell id="cB" parent="1" style="swimlane;startSize=28;fillColor=#F7F8FA;strokeColor=#C9D1DC;html=1;fontStyle=1;fontColor=#1B1F24;verticalAlign=top;" value="2 · Parse passes — strict order" vertex="1">
                    <mxGeometry height="600" width="440" x="500" y="100" as="geometry"/>
                </mxCell>
                <mxCell id="b1" parent="cB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=11;" value="&lt;b&gt;parse_settings()&lt;/b&gt; :1447&lt;br&gt;BFWM.* scalars: gaps, border, layout, disabled monitors" vertex="1">
