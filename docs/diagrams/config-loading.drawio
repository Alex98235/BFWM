                </mxCell>
                <mxCell id="b5" parent="cB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=11;" value="&lt;b&gt;parse_window_rules()&lt;/b&gt; :257&lt;br&gt;&lt;i&gt;frees the previous rule vector first&lt;/i&gt;" vertex="1">
