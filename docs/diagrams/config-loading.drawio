                    <mxGeometry height="56" width="408" x="16" y="222" as="geometry"/>
                </mxCell>
                <mxCell id="b4b" parent="cB" style="text;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;fontColor=#5A626E;" value="absent keybinds = C defaults kept · present-empty = all cleared · present = clear + replace" vertex="1">
