                    <mxGeometry height="48" width="388" x="16" y="276" as="geometry"/>
                </mxCell>
                <mxCell id="a6" parent="cA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontSize=11;" value="Register C closures:&lt;br&gt;BFWM.notify · BFWM.exec_cache · BFWM.spawn" vertex="1">
