                <mxCell id="cC" parent="1" style="swimlane;startSize=28;fillColor=#F7F8FA;strokeColor=#C9D1DC;html=1;fontStyle=1;fontColor=#1B1F24;verticalAlign=top;" value="3 · Runtime artifacts and 4 · Apply" vertex="1">
                    <mxGeometry height="600" width="460" x="1010" y="101" as="geometry"/>
                </mxCell>
                <mxCell id="c1" parent="cC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6E0;strokeColor=#E8C36A;fontSize=11;" value="&lt;b&gt;shared-&amp;gt;keybinds&lt;/b&gt; KeybindDictionary&lt;br&gt;vector of Keystroke + actions · collisions append&lt;br&gt;&lt;i&gt;generation++ invalidates in-flight dispatch&lt;/i&gt;" vertex="1">
                    <mxGeometry height="64" width="428" x="16" y="36" as="geometry"/>
                </mxCell>
                <mxCell id="c2" parent="cC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6E0;strokeColor=#E8C36A;fontSize=11;" value="&lt;b&gt;main-&amp;gt;window_rules&lt;/b&gt; vector of WindowRule*&lt;br&gt;match entries + float/ignore/workspace action" vertex="1">
                    <mxGeometry height="56" width="428" x="16" y="108" as="geometry"/>
                </mxCell>
                <mxCell id="c3" parent="cC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6E0;strokeColor=#E8C36A;fontSize=11;" value="&lt;b&gt;shared-&amp;gt;config&lt;/b&gt; scalars&lt;br&gt;gap_between · gap_edge · border_color · inactive_border&lt;br&gt;border_width/radius · focus_follows_mouse · default_layout" vertex="1">
                    <mxGeometry height="64" width="428" x="16" y="172" as="geometry"/>
                </mxCell>
                <mxCell id="c4" parent="cC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6E0;strokeColor=#E8C36A;fontSize=11;" value="&lt;b&gt;workspace_configs[32]&lt;/b&gt; id · label · monitor · layout" vertex="1">
                    <mxGeometry height="44" width="428" x="16" y="244" as="geometry"/>
                </mxCell>
                <mxCell id="c5" parent="cC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6E0;strokeColor=#E8C36A;fontSize=11;" value="&lt;b&gt;bar_cfg&lt;/b&gt; indicators[8] each with states[8]&lt;br&gt;&lt;b&gt;snackbar_cfg&lt;/b&gt; theme + timing" vertex="1">
                    <mxGeometry height="56" width="428" x="16" y="296" as="geometry"/>
                </mxCell>
                <mxCell id="c6" parent="cC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=11;strokeWidth=2;" value="&lt;b&gt;HandleReloadConfig()&lt;/b&gt; handlers.cpp:1085&lt;br&gt;bar_height → SetBarHeight per monitor&lt;br&gt;RecalculateAllWorkspaceRects&lt;br&gt;BAR_UPDATE_RECREATE → bars torn down + rebuilt&lt;br&gt;PushGapConfigToAllWorkspaces → re-apply borders" vertex="1">
                    <mxGeometry height="90" width="428" x="16" y="360" as="geometry"/>
                </mxCell>
                <mxCell id="cNote" parent="cC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#E9D58A;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;" value="&lt;b&gt;Trigger: keybind only.&lt;/b&gt; ActionReloadConfig, default Alt+Ctrl+R (defaults.cpp:130). There is no file watcher, no signal, no timer — editing config.lua does nothing until you press the key." vertex="1">
                    <mxGeometry height="76" width="428" x="16" y="460" as="geometry"/>
                </mxCell>
                <mxCell id="cV" parent="1" style="swimlane;startSize=28;fillColor=#F7F8FA;strokeColor=#C9D1DC;html=1;fontStyle=1;fontColor=#1B1F24;verticalAlign=top;" value="Validation — three layers" vertex="1">
                    <mxGeometry height="330" width="700" x="40" y="720" as="geometry"/>
                </mxCell>
                <mxCell id="v1" parent="cV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#EBA3A3;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;" value="&lt;b&gt;HARD · unknown key&lt;/b&gt;  __newindex compares against a fixed whitelist (known_BFWM_keys[18], known_bar_keys, known_snackbar_keys[28], nested color/font/margin/border tables). On a miss: Snackbar::Warn then &lt;b&gt;luaL_error&lt;/b&gt; — which aborts luaL_dofile and takes the syntax-error path." vertex="1">
                    <mxGeometry height="66" width="668" x="16" y="36" as="geometry"/>
                </mxCell>
                <mxCell id="v2" parent="cV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6E0;strokeColor=#E8C36A;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;" value="&lt;b&gt;SOFT · wrong type&lt;/b&gt;  each field reader checks lua_isinteger / isboolean / isstring. Mismatch → Snackbar::Warn, the field keeps its default, parsing continues." vertex="1">
                    <mxGeometry height="48" width="668" x="16" y="110" as="geometry"/>
                </mxCell>
                <mxCell id="v3" parent="cV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6E0;strokeColor=#E8C36A;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;" value="&lt;b&gt;VALUE · clamp or reject&lt;/b&gt;  opacity 0–255 · queue 1–16 · indicators ≤ 8 · states ≤ 8 · disabled monitors ≤ 16 · snackbar min&amp;gt;max swapped. Unknown layout / monitor / rule operator → Warn." vertex="1">
                    <mxGeometry height="60" width="668" x="16" y="166" as="geometry"/>
                </mxCell>
                <mxCell id="v4" parent="cV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#B8C0CC;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;" value="&lt;b&gt;User-visible surface:&lt;/b&gt; Snackbar::Warn and Snackbar::Error both log and show a toast overlay. Exception: nested Bar indicator/state warnings are log-only (validate_indicator_keys / validate_state_keys)." vertex="1">
                    <mxGeometry height="66" width="668" x="16" y="234" as="geometry"/>
                </mxCell>
                <mxCell id="cF" parent="1" style="swimlane;startSize=28;fillColor=#F7F8FA;strokeColor=#C9D1DC;html=1;fontStyle=1;fontColor=#1B1F24;verticalAlign=top;" value="Failure modes — and one real trap" vertex="1">
                    <mxGeometry height="330" width="680" x="760" y="720" as="geometry"/>
                </mxCell>
                <mxCell id="f1" parent="cF" style="text;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;" value="&lt;b&gt;Missing file&lt;/b&gt; → Warn &quot;No custom config found&quot;, path cleared, load returns TRUE with pure defaults." vertex="1">
                    <mxGeometry height="30" width="648" x="16" y="36" as="geometry"/>
                </mxCell>
                <mxCell id="f2" parent="cF" style="text;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;" value="&lt;b&gt;Syntax error / unknown key&lt;/b&gt; → Error toast, LuaConfigLoad returns false. Rules and workspace configs are NOT freed on this path,&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;so the previous ones survive.&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="44" width="648" x="16" y="70" as="geometry"/>
                </mxCell>
                <mxCell id="f3" parent="cF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#EBA3A3;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;strokeWidth=2;" value="&lt;b&gt;THE TRAP — no rollback.&lt;/b&gt; Because ConfigLoadDefaults ran before luaL_dofile, a failed load leaves scalars, keybinds and bar/snackbar config at &lt;b&gt;C++ defaults&lt;/b&gt;, while window_rules and workspace_configs still hold the &lt;b&gt;previous&lt;/b&gt; values. The process is left in a mixed state, not the old config." vertex="1">
                    <mxGeometry height="80" width="648" x="16" y="122" as="geometry"/>
                </mxCell>
                <mxCell id="f4" parent="cF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#EBA3A3;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;" value="&lt;b&gt;Reload ignores the result.&lt;/b&gt; HandleReloadConfig computes success but then applies anyway: bar height, rects, gaps, borders and BAR_UPDATE_RECREATE are pushed to the live session even when the load failed." vertex="1">
                    <mxGeometry height="64" width="648" x="16" y="212" as="geometry"/>
                </mxCell>
                <mxCell id="f5" parent="cF" style="text;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;fontColor=#5A626E;" value="What survives a successful reload: Lua VM, monitors, live windows, workspaces, focus and active-workspace identity. Only labels,&lt;div&gt;&lt;span style=&quot;color: rgb(90, 98, 110);&quot;&gt;&amp;nbsp;monitor assignment, rules, keybinds and theme are rebuilt.&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="40" width="648" x="16" y="282" as="geometry"/>
                </mxCell>
                <mxCell id="e1" edge="1" parent="1" source="a8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;fontSize=10;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="b1" value="file executed OK">
