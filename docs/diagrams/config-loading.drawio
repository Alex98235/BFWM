                <mxCell id="e12" edge="1" parent="1" source="b7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontColor=#5A626E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;fontSize=10;strokeWidth=2;" target="c6" value="apply">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <object label="Based on commit 137651a (2026-11-27) · src/config/**, src/config/lua/**, config.lua, src/main.cpp" basedOn="137651a" date="2026-11-27" covers="config.lua;config-types.lua;src/config;src/main.cpp" id="prov">
                    <mxCell parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A94A6;" vertex="1">
                        <mxGeometry height="24" width="680" x="760" y="1090" as="geometry"/>
                    </mxCell>
