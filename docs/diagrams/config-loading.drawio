                <mxCell id="b7" parent="cB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontSize=11;" value="&lt;b&gt;update_workspace_configs_on_reload()&lt;/b&gt; :1844&lt;br&gt;relabel live workspaces, move them across monitors" vertex="1">
                    <mxGeometry height="52" width="408" x="16" y="442" as="geometry"/>
                </mxCell>
                <mxCell id="bNote" parent="cB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#E9D58A;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;" value="There is no reflection layer: each pass reads named fields into fixed structs. Actions are the exception — a strcmp chain in build_action maps a Lua action name to a typed BFWMAction (tagged union, action.h:167)." vertex="1">
                    <mxGeometry height="76" width="408" x="16" y="506" as="geometry"/>
                </mxCell>
