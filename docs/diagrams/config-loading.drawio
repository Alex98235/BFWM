                <mxCell id="a4" parent="cA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontSize=11;" value="luaL_newstate + luaL_openlibs&lt;br&gt;&lt;i&gt;VM is reused on reload — never recreated&lt;/i&gt;" vertex="1">
                    <mxGeometry height="48" width="388" x="16" y="220" as="geometry"/>
