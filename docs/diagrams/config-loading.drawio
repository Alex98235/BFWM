                <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1B1F24;" value="BFWM — Config Loading" vertex="1">
                    <mxGeometry height="34" width="900" x="40" y="16" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A626E;" value="config.lua is executed by an embedded Lua VM that validates keys through __newindex guards. Defaults are written FIRST, then the user file overwrites them field by field." vertex="1">
                    <mxGeometry height="26" width="1400" x="40" y="50" as="geometry"/>
                </mxCell>
                <mxCell id="cA" parent="1" style="swimlane;startSize=28;fillColor=#F7F8FA;strokeColor=#C9D1DC;html=1;fontStyle=1;fontColor=#1B1F24;verticalAlign=top;" value="1 · Resolve and load" vertex="1">
                    <mxGeometry height="600" width="420" x="40" y="100" as="geometry"/>
                </mxCell>
                <mxCell id="a1" parent="cA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#B8C0CC;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;" value="&lt;b&gt;ResolveConfigPath(&amp;quot;config.lua&amp;quot;)&lt;/b&gt; config_paths.cpp:16" vertex="1">
                    <mxGeometry height="34" width="388" x="16" y="36" as="geometry"/>
                </mxCell>
                <mxCell id="a1b" parent="cA" style="text;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;fontColor=#5A626E;" value="%APPDATA%\BFWM\  then  %USERPROFILE%\.config\BFWM\&lt;br&gt;--config overrides; first existing file wins. Missing = warn + pure defaults (not an error)." vertex="1">
                    <mxGeometry height="52" width="388" x="16" y="72" as="geometry"/>
                </mxCell>
                <mxCell id="a2" parent="cA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=11;" value="&lt;b&gt;LoadConfig()&lt;/b&gt; main.cpp:333&lt;br&gt;--no-bar forces bar_cfg.enabled = FALSE" vertex="1">
                    <mxGeometry height="44" width="388" x="16" y="122" as="geometry"/>
                </mxCell>
                <mxCell id="a3" parent="cA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontSize=11;strokeWidth=2;" value="&lt;b&gt;LuaConfigLoad()&lt;/b&gt; parser.cpp:1872" vertex="1">
                    <mxGeometry height="32" width="388" x="16" y="180" as="geometry"/>
