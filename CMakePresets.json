{
  "version": 2,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "ucrt64",
      "displayName": "MSYS2 UCRT64 + Clang (Ninja)",
      "description": "Canonical build: MSYS2 UCRT64 clang/clang++/windres (resolved from PATH), Ninja generator, output in build/.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_RC_COMPILER": "windres",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ucrt64",
      "configurePreset": "ucrt64"
    }
  ]
}
