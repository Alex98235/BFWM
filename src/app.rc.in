#include <winver.h>

1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/icons/bfwm.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @BFWM_VERSION_MAJOR@,@BFWM_VERSION_MINOR@,@BFWM_VERSION_PATCH@,0
 PRODUCTVERSION @BFWM_VERSION_MAJOR@,@BFWM_VERSION_MINOR@,@BFWM_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "BFWM"
            VALUE "FileDescription", "BFWM tiling window manager"
            VALUE "FileVersion", "@BFWM_VERSION@"
            VALUE "InternalName", "BFWM"
            VALUE "OriginalFilename", "BFWM.exe"
            VALUE "ProductName", "BFWM"
            VALUE "ProductVersion", "@BFWM_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END